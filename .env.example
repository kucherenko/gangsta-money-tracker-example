# ─── General ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Host ports exposed by Docker Compose (change if you have conflicts)
APP_PORT=3001
OLLAMA_PORT=11434

# ─── Admin Credentials ────────────────────────────────────────
# CHANGE THESE IN PRODUCTION
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ─── Security ─────────────────────────────────────────────────
# CHANGE THIS IN PRODUCTION — must be a strong secret
JWT_SECRET=money-tracker-secret-key

# ─── Database ─────────────────────────────────────────────────
# Absolute path inside the container for SQLite file
DB_PATH=/app/backend/db/data.sqlite

# ─── External APIs ────────────────────────────────────────────
# Currency exchange rates API
RATE_API_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies

# ─── Ollama (receipt OCR) ───────────────────────────────────
# Ollama base URL — in Docker Compose this points to the ollama service
OLLAMA_HOST=http://ollama:11434
# Ollama model to use for OCR
OLLAMA_MODEL=qwen3-vl:235b-cloud

# ─── Frontend Static Files ────────────────────────────────────
STATIC_DIR=/app/frontend/dist
